# Server
PORT=5050

# Database (use mongodb://mongodb:27017/ecohealth when running with Docker)
MONGO_URI=mongodb://localhost:27017/ecohealth

# JWT - any long random string
JWT_SECRET=change_me_to_a_long_random_string

# External APIs
OPENWEATHER_API_KEY=your_openweather_key
OPENAQ_API_KEY=your_openaq_key

# Geocoding (OpenCage)
GEOCODING_API_KEY=your_opencage_key

# Email (Gmail app password)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# AI risk engine: RULE or AI
GROQ_API_KEY=your_groq_key
RISK_ENGINE_MODE=RULE
FRONTEND_URL=http://localhost
